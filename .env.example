# db-report-agent 环境配置模板
# 使用方法：把本文件复制为 .env，填入你的真实值，然后运行。
#   cp .env.example .env        （Linux/macOS）
#   copy .env.example .env      （Windows）
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git，也不会在 GitHub 暴露。
#       只有本 .env.example 模板会进入仓库。

# LLM 接入（重量路径 --llm 需要）
# OpenAI 兼容的 chat/completions 服务地址（默认 DeepSeek）
DBR_LLM_BASE_URL=https://api.deepseek.com/v1
# 你的 API Key（必填，否则 --llm 会提示未配置）
DBR_LLM_API_KEY=sk-在此填入你的key
# 模型名（可选，默认 deepseek-chat）
DBR_LLM_MODEL=deepseek-chat
